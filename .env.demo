# ========================================
# DEMO MODE CONFIGURATION
# ========================================
# This configuration enables demo mode without requiring:
# - PostgreSQL database
# - Redis
# - Stripe account
# - Email SMTP server
# - AWS S3
# ========================================

# Enable Demo Mode
DEMO_MODE=True

# Application Settings
ENVIRONMENT=demo
DEBUG=True
LOG_LEVEL=INFO

# Security Keys (automatically set for demo - OK for testing only!)
SECRET_KEY=demo-secret-key-for-testing-only-do-not-use-in-production
JWT_SECRET_KEY=demo-jwt-secret-key-for-testing-only-do-not-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Security Settings
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# Content Settings
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp
ARTICLES_PER_PAGE=20
DRAFT_AUTOSAVE_INTERVAL_SECONDS=30

# Payment Settings (not used in demo mode, but included for reference)
PLATFORM_FEE_PERCENTAGE=15
MINIMUM_PAYOUT_USD=10
PAYOUT_SCHEDULE=weekly

# Rate Limiting
RATE_LIMIT_AUTHENTICATED=100
RATE_LIMIT_ANONYMOUS=20

# ========================================
# The following are NOT REQUIRED in demo mode:
# ========================================
# DATABASE_URL - Uses in-memory storage instead
# REDIS_URL - Not needed
# STRIPE_SECRET_KEY - Not needed
# STRIPE_PUBLISHABLE_KEY - Not needed
# STRIPE_WEBHOOK_SECRET - Not needed
# EMAIL_HOST - Not needed
# EMAIL_USERNAME - Not needed
# EMAIL_PASSWORD - Not needed
# EMAIL_FROM - Not needed
# AWS_ACCESS_KEY_ID - Not needed
# AWS_SECRET_ACCESS_KEY - Not needed
# AWS_S3_BUCKET - Not needed
# ELASTICSEARCH_URL - Not needed
# OPENAI_API_KEY - Optional
# ANTHROPIC_API_KEY - Optional
# SENTRY_DSN - Optional
