# Demo Mode Configuration
DEMO_MODE=True
ENVIRONMENT=demo
DEBUG=True

# Security Keys (Demo Only - Change in Production!)
SECRET_KEY=demo-secret-key-for-testing-only-do-not-use-in-production
JWT_SECRET_KEY=demo-jwt-secret-key-for-testing-only-do-not-use-in-production

# CORS - Allow frontend origin (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend URL
FRONTEND_URL=http://localhost:3000

# API Configuration
API_V1_PREFIX=/api/v1
